# Local development environment variables
# Used by docker-compose and .NET server

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=victoria
DATABASE_PASSWORD=victoria_dev_password
DATABASE_NAME=victoria_world
DATABASE_CONNECTION_STRING=Server=localhost;Port=5432;Database=victoria_world;User Id=victoria;Password=victoria_dev_password;

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379

# Server
SERVER_PORT=5000
ENVIRONMENT=Development
LOG_LEVEL=Debug

