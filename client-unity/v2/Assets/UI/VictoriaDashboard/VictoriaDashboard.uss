/* ============================================================
   Victoria-like dashboard — Vic2-inspired chrome
   Palette:
     bg        rgb(28, 32, 42)     - dark navy
     chrome    rgb(20, 24, 32)     - top bar
     panel-bg  rgb(48, 44, 38)     - warm sepia panel
     panel-bg2 rgb(58, 53, 46)     - row hover
     gold      rgb(212, 175,  92)  - accent
     gold-dim  rgb(150, 122,  64)
     ink       rgb(232, 224, 200)  - body text on panels
     muted     rgb(170, 162, 142)
   ============================================================ */

.dashboard-root {
    flex-grow: 1;
    padding: 10px;
    background-color: rgb(28, 32, 42);
    color: rgb(232, 224, 200);
    font-size: 13px;
}

/* ============== TOP STATUS BAR ============== */
.top-bar {
    height: 64px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 6px;
    background-color: rgb(20, 24, 32);
    border-width: 1px;
    border-color: rgb(150, 122, 64);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 175, 92);
}

.status-country-card {
    flex-direction: row;
    align-items: center;
}

.country-shield {
    width: 44px;
    height: 44px;
    background-color: rgb(110,  60,  60);
    border-width: 2px;
    border-color: rgb(212, 175, 92);
    margin-right: 12px;
}

.country-card-text {
    flex-direction: column;
    margin-right: 14px;
}

.status-country-name {
    color: rgb(244, 232, 198);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
}

.status-country-stats {
    color: rgb(206, 192, 156);
    font-size: 12px;
    margin-top: 2px;
}

.status-metrics {
    flex-direction: row;
    align-items: center;
}

.status-metric {
    flex-direction: column;
    align-items: flex-start;
    margin-right: 18px;
    min-width: 60px;
}

.status-metric-label {
    color: rgb(150, 122, 64);
    -unity-font-style: bold;
    font-size: 10px;
    letter-spacing: 1px;
}

.status-metric-value {
    color: rgb(244, 232, 198);
    -unity-font-style: bold;
    font-size: 14px;
    margin-top: 2px;
}

.status-warn { color: rgb(232, 180, 83); }
.status-ok   { color: rgb(132, 214, 132); }
.status-crit { color: rgb(232, 100, 100); }

/* ============== TAB STRIP ============== */
.tab-strip {
    height: 26px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgb(20, 24, 32);
    border-bottom-width: 1px;
    border-bottom-color: rgb(150, 122, 64);
    padding-left: 8px;
    margin-bottom: 8px;
}

.tab {
    color: rgb(150, 142, 122);
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 2px;
    padding-left: 12px;
    padding-right: 12px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-color: rgb(60, 56, 48);
    height: auto;
    min-width: 0;
    margin: 0;
}

.tab:hover {
    color: rgb(212, 175, 92);
    background-color: rgb(40, 36, 30);
}

.tab-active {
    color: rgb(244, 232, 198);
    background-color: rgb(48, 44, 38);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 175, 92);
}

.tab-active:hover {
    color: rgb(244, 232, 198);
    background-color: rgb(48, 44, 38);
}

/* ============== TAB-DRIVEN VIEW VISIBILITY ============== */
/* Default = view-production: every panel is visible; placeholders are hidden. */

.placeholder-grid {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    display: none;
}

.placeholder-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    display: none;
}

/* USS does not support :last-child; trailing margin handled in C# via a modifier class if needed. */

/* When NOT on production view, hide untagged panels. We do this by hiding
   each panel that is not part of the active view. The simplest scheme is to
   list each non-production view's "keep visible" set explicitly. */

.dashboard-root.view-budget .provinces-panel,
.dashboard-root.view-budget .province-detail-panel,
.dashboard-root.view-budget .pops-panel,
.dashboard-root.view-budget .military-panel,
.dashboard-root.view-budget .market-panel,
.dashboard-root.view-budget .column-left,
.dashboard-root.view-budget .column-center { display: none; }

.dashboard-root.view-population .provinces-panel,
.dashboard-root.view-population .province-detail-panel,
.dashboard-root.view-population .budget-panel,
.dashboard-root.view-population .military-panel,
.dashboard-root.view-population .market-panel,
.dashboard-root.view-population .column-left,
.dashboard-root.view-population .column-right { display: none; }

.dashboard-root.view-military .provinces-panel,
.dashboard-root.view-military .province-detail-panel,
.dashboard-root.view-military .pops-panel,
.dashboard-root.view-military .budget-panel,
.dashboard-root.view-military .market-panel,
.dashboard-root.view-military .column-left,
.dashboard-root.view-military .column-center { display: none; }

.dashboard-root.view-diplomacy .provinces-panel,
.dashboard-root.view-diplomacy .province-detail-panel,
.dashboard-root.view-diplomacy .pops-panel,
.dashboard-root.view-diplomacy .budget-panel,
.dashboard-root.view-diplomacy .market-panel,
.dashboard-root.view-diplomacy .column-left,
.dashboard-root.view-diplomacy .column-center { display: none; }

.dashboard-root.view-trade .provinces-panel,
.dashboard-root.view-trade .province-detail-panel,
.dashboard-root.view-trade .pops-panel,
.dashboard-root.view-trade .budget-panel,
.dashboard-root.view-trade .military-panel,
.dashboard-root.view-trade .main-grid { display: none; }

.dashboard-root.view-politics .main-grid { display: none; }
.dashboard-root.view-politics .placeholder-grid { display: flex; }
.dashboard-root.view-politics .placeholder-panel.tab-politics { display: flex; }

.dashboard-root.view-technology .main-grid { display: none; }
.dashboard-root.view-technology .placeholder-grid { display: flex; }
.dashboard-root.view-technology .placeholder-panel.tab-technology { display: flex; }

/* When a single column survives, let it expand to fill the width. */
.dashboard-root.view-budget .column-right,
.dashboard-root.view-military .column-right,
.dashboard-root.view-diplomacy .column-right { width: auto; flex-grow: 1; }

.dashboard-root.view-population .column-center { flex-grow: 1; }

/* In Trade view, hide the bottom event-feed too so the market fills everything,
   except keep the event log so alerts remain visible. */
.dashboard-root.view-trade .market-panel { display: flex; flex-grow: 2; }

/* ============== MAIN GRID ============== */
.main-grid {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.column {
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.column-left {
    width: 290px;
    margin-right: 8px;
    flex-shrink: 0;
}

.column-center {
    flex-grow: 1;
    margin-right: 8px;
    min-width: 0;
}

.column-right {
    width: 420px;
    flex-shrink: 0;
    overflow: hidden;
}

/* ============== PANEL CHROME ============== */
.panel {
    background-color: rgb(48, 44, 38);
    border-width: 1px;
    border-color: rgb(96, 80, 52);
    padding: 10px;
    margin-bottom: 8px;
    overflow: hidden;
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(96, 80, 52);
    padding-bottom: 4px;
}

.header-actions {
    flex-direction: row;
}

.panel-title {
    color: rgb(212, 175, 92);
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 0;
}

.headline {
    color: rgb(248, 240, 216);
    -unity-font-style: bold;
    font-size: 18px;
    margin-bottom: 6px;
}

.body {
    color: rgb(228, 220, 200);
    white-space: normal;
}

.helper-label { margin-top: 4px; margin-bottom: 4px; }
.muted { color: rgb(170, 162, 142); }

/* ============== COLUMN-SPECIFIC HEIGHTS ============== */
.provinces-panel {
    flex-grow: 1;
    min-height: 200px;
}

.province-detail-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 280px;
}

.province-info-scroll {
    flex-grow: 1;
    min-height: 80px;
    margin-bottom: 6px;
}

.pops-panel {
    height: 320px;
    flex-shrink: 0;
}

.pop-summary-scroll { flex-grow: 1; min-height: 0; }

.pop-slicer {
    flex-direction: column;
    margin-bottom: 6px;
}

.pop-slicer-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.pop-slicer-label {
    color: rgb(150, 122, 64);
    -unity-font-style: bold;
    font-size: 10px;
    letter-spacing: 1px;
    margin-right: 8px;
    width: 56px;
}

.pop-group-by-button {
    margin-right: 4px;
}

.pop-group-by-active {
    background-color: rgb(96, 76, 38);
    border-color: rgb(212, 175, 92);
    color: rgb(248, 240, 216);
}

.pop-filter-dropdown {
    width: 130px;
    margin-right: 6px;
}

.budget-panel {
    flex-grow: 1;
    min-height: 240px;
    flex-shrink: 1;
}

.budget-scroll { flex-grow: 1; min-height: 0; }

.military-panel {
    height: 280px;
    flex-shrink: 0;
}

/* ============== BOTTOM ALERT STRIP ============== */
.bottom-strip {
    height: 170px;
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 4px;
}

.bottom-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 0;
    margin-right: 8px;
    background-color: rgb(40, 38, 34);
}

/* USS does not support :last-child; see note above. */

.market-panel { }
.event-feed-panel { }
.event-feed-list { flex-grow: 1; }
.scroll-list { flex-grow: 1; }
.province-list { flex-grow: 1; }

/* ============== ROW STYLES ============== */
.province-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 32px;
    margin-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(58, 53, 46);
    border-left-width: 3px;
    border-left-color: rgb(96, 80, 52);
}

.province-row:hover {
    background-color: rgb(72, 66, 56);
}

.province-row-selected {
    border-left-color: rgb(212, 175, 92);
    background-color: rgb(78, 70, 52);
}

.province-name {
    -unity-font-style: bold;
    color: rgb(248, 240, 216);
}

.province-meta {
    color: rgb(180, 170, 144);
}

.army-list {
    height: 80px;
    margin-top: 4px;
    margin-bottom: 6px;
}

.army-row {
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(58, 53, 46);
    border-left-width: 3px;
    border-left-color: rgb(120, 100, 64);
}

.army-row:hover { background-color: rgb(72, 66, 56); }

.army-row-selected {
    border-left-color: rgb(212, 175, 92);
    background-color: rgb(78, 70, 52);
}

.army-name {
    -unity-font-style: bold;
    color: rgb(248, 240, 216);
}

.army-meta {
    color: rgb(180, 170, 144);
    font-size: 12px;
    white-space: normal;
}

.military-summary {
    color: rgb(228, 220, 200);
    background-color: rgb(38, 36, 32);
    border-left-width: 3px;
    border-left-color: rgb(132, 192, 132);
    padding-left: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-bottom: 5px;
}

.military-selection {
    color: rgb(216, 208, 188);
    background-color: rgb(58, 53, 46);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-bottom: 5px;
    white-space: normal;
}

.war-summary {
    color: rgb(216, 208, 188);
    background-color: rgb(38, 36, 32);
    border-left-width: 3px;
    border-left-color: rgb(232, 180, 83);
    padding-left: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    min-height: 32px;
    white-space: normal;
}

.military-actions {
    justify-content: space-between;
    margin-top: 4px;
    margin-bottom: 0;
}

.military-action-button {
    flex-grow: 1;
    min-width: 0;
}

.market-row {
    flex-direction: row;
    justify-content: space-between;
    height: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 64, 54);
}

.event-row {
    margin-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgb(58, 53, 46);
    border-left-width: 3px;
    border-left-color: rgb(120, 100, 64);
}

.event-row:hover { background-color: rgb(72, 66, 56); }

.event-row-critical { border-left-color: rgb(222, 94, 94); }
.event-row-warn     { border-left-color: rgb(232, 180, 83); }
.event-row-info     { border-left-color: rgb(112, 168, 248); }

.event-title {
    -unity-font-style: bold;
    color: rgb(248, 240, 216);
}

.event-message {
    color: rgb(186, 176, 152);
    font-size: 12px;
    white-space: normal;
}

.event-why-button {
    align-self: flex-start;
    margin-top: 4px;
}

.explain-button { margin-left: 6px; }
.market-why-button { margin-left: 6px; }

/* ============== BUTTONS ============== */
.button-row {
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 6px;
}

.button-row.compact {
    margin-top: 0;
    margin-bottom: 6px;
}

.toolbar { flex-wrap: wrap; }

.province-search-field {
    width: 110px;
    height: 24px;
    margin-right: 4px;
}

.button {
    height: 28px;
    min-width: 70px;
    margin-right: 4px;
    background-color: rgb(74, 66, 50);
    border-width: 1px;
    border-color: rgb(120, 100, 64);
    color: rgb(244, 232, 198);
}

.button:hover {
    background-color: rgb(96, 84, 60);
    border-color: rgb(212, 175, 92);
}

.button.secondary {
    background-color: rgb(60, 54, 44);
}

.button:disabled {
    color: rgb(120, 110, 92);
    background-color: rgb(40, 38, 34);
    border-color: rgb(60, 56, 48);
}

.button.small {
    height: 24px;
    min-width: 50px;
    font-size: 11px;
}

.button.gold-button {
    background-color: rgb(96, 76, 38);
    border-color: rgb(212, 175, 92);
    color: rgb(248, 240, 216);
}

.button.gold-button:hover {
    background-color: rgb(132, 104, 50);
}

.control-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.control-grid .button {
    width: 88px;
    margin-bottom: 4px;
}

.budget-status-list {
    margin-top: 6px;
    margin-bottom: 6px;
}

.budget-state-row {
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(58, 53, 46);
    border-left-width: 3px;
    border-left-color: rgb(120, 100, 64);
    font-size: 11px;
}

.budget-state-idle {
    color: rgb(180, 170, 144);
    border-left-color: rgb(120, 100, 64);
}

.budget-state-draft {
    color: rgb(232, 210, 132);
    border-left-color: rgb(212, 175, 92);
}

.budget-state-submitting {
    color: rgb(160, 207, 255);
    border-left-color: rgb(112, 168, 248);
}

.budget-state-retry {
    color: rgb(255, 202, 128);
    border-left-color: rgb(232, 151, 74);
}

.budget-state-settled {
    color: rgb(132, 220, 150);
    border-left-color: rgb(88, 191, 119);
}

.button-pending {
    border-color: rgb(112, 168, 248);
    background-color: rgb(67, 73, 90);
}

.button-retry {
    border-color: rgb(232, 151, 74);
    background-color: rgb(90, 73, 58);
}
